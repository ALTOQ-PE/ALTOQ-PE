# ==============================================================================
# ALTOQ PE - VARIABLES DE ENTORNO (0% COLD START & ZERO-SLEEP CONFIG)
# REGLA ESTRICTA: Sin uso de emojis en código ni comentarios
# ==============================================================================

# 1. Base de Datos PostgreSQL (Supabase / Neon con Pooler para Serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# 2. Supabase Auth y Storage
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Parametros de Aplicacion y PWA
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Pasarela de Pagos Culqi
NEXT_PUBLIC_CULQI_PUBLIC_KEY="pk_test_..."
CULQI_SECRET_KEY="sk_test_..."

# 5. Notificaciones y Correos Transaccionales (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="notificaciones@altoq.pe"

# 6. Cron Job de Keep-Alive (Ping a /api/health cada 12 horas)
CRON_SECRET="altoq_keepalive_secure_token_2026"
